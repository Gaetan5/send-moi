# ==============================================================================
#                 SEND MOI — MODÈLE D'ENVIRONNEMENT (.env.example)
# ==============================================================================

NODE_ENV=production
PORT=3000
API_BASE_URL="https://api.sendmoi.cm"

POSTGRES_USER=send_moi_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=send_moi_db
DATABASE_URL="postgresql://send_moi_user:your_secure_db_password@postgres:5432/send_moi_db?schema=public"

REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET="generate_random_64_character_hex_secret_key"
ALLOWED_ORIGINS="https://sendmoi.cm,https://api.sendmoi.cm"

# MTN Mobile Money (+237)
MTN_MOMO_PRIMARY_KEY="your_mtn_momo_primary_key"
MTN_MOMO_USER_ID="your_mtn_momo_user_id"
MTN_MOMO_API_SECRET="your_mtn_momo_api_secret"
MTN_MOMO_ENVIRONMENT="production"

# Orange Money (+237)
ORANGE_MONEY_CLIENT_ID="your_orange_money_client_id"
ORANGE_MONEY_CLIENT_SECRET="your_orange_money_client_secret"
ORANGE_MONEY_MERCHANT_KEY="your_orange_money_merchant_key"

# Africa's Talking SMS (+237)
AFRICAS_TALKING_USERNAME="your_africas_talking_username"
AFRICAS_TALKING_API_KEY="your_africas_talking_api_key"
SMS_SENDER_ID="SendMoi"

# S3 Storage
S3_BUCKET_NAME="send-moi-proofs-bucket"
S3_REGION="eu-west-3"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
S3_BUCKET_URL="https://send-moi-proofs-bucket.s3.eu-west-3.amazonaws.com"
